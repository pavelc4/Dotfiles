# Matugen generated Mako config
max-history=50
sort=-time

# Geometry & Appearance
width=360
height=150
margin=14
padding=12
border-size=0
border-radius=12
border-color=#00000000
background-color=#111418f0
text-color=#e1e2e8
progress-color=over #a0cafd

# Default timeout in milliseconds (5000 = 5 seconds)
default-timeout=5000
ignore-timeout=0

[urgency=low]
default-timeout=3000

[urgency=normal]
default-timeout=5000

[urgency=critical]
default-timeout=0
