[
  // Laptop Display (eDP-1) - Compact 38px
  {
    "name": "laptop",
    "output": "eDP-1",
    "reload_style_on_change": true,
    "layer": "top",
    "position": "left",
    "width": 38,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "include": ["~/.config/waybar/modules.json"],
    "modules-left": [
      "custom/distro",
      "clock",
      "hyprland/workspaces"
    ],
    "modules-center": [
      "hyprland/window"
    ],
    "modules-right": [
      "group/extras",
      "idle_inhibitor",
      "group/system",
      "custom/powermenu"
    ]
  },

  // External Displays (HDMI-A-1 / DP-1 / DP-2) - Generous 48px
  {
    "name": "external",
    "output": ["HDMI-A-1", "DP-1", "DP-2", "!eDP-1"],
    "reload_style_on_change": true,
    "layer": "top",
    "position": "left",
    "width": 48,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "include": ["~/.config/waybar/modules.json"],
    "modules-left": [
      "custom/distro",
      "clock",
      "hyprland/workspaces"
    ],
    "modules-center": [
      "hyprland/window"
    ],
    "modules-right": [
      "group/extras",
      "idle_inhibitor",
      "group/system",
      "custom/powermenu"
    ]
  }
]
