# Matugen generated Mako config
max-history=50
sort=-time

# Geometry & Appearance
width=360
height=150
margin=14
padding=12
border-size=0
border-radius=12
border-color=#00000000
background-color={{colors.surface.default.hex}}f0
text-color={{colors.on_surface.default.hex}}
progress-color=over {{colors.primary.default.hex}}

# Default timeout in milliseconds (5000 = 5 seconds)
default-timeout=5000
ignore-timeout=0

[urgency=low]
default-timeout=3000

[urgency=normal]
default-timeout=5000

[urgency=critical]
default-timeout=0
